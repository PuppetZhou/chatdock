Screen { background: $deck-bg; color: $deck-text; }
Footer { background: $deck-panel; }
#summary { height: 3; padding: 1 1; background: $deck-surface; color: $deck-text; text-style: bold; }
#workspace { height: 1fr; }
#sidebar { width: 29; min-width: 22; background: $deck-panel; padding: 0 1; border-right: solid $deck-border; }
.section-title { height: 3; padding: 1 1; color: $deck-muted; text-style: bold; }
#folders { height: 1fr; overflow-x: auto; background: $deck-panel; scrollbar-size: 1 1; }
#folder-search { margin: 0; }
#recursive { margin: 0; border: none; }
#legend { height: 5; color: $deck-muted; padding-top: 1; }
#center { width: 1fr; min-width: 30; padding: 0 1; }
#toolbar { height: 3; margin-top: 1; }
#search { width: 1fr; }
#refresh { min-width: 11; width: 11; margin-left: 1; }
#filters { height: 3; margin-top: 1; }
Select { width: 1fr; margin-right: 1; }
#scope { height: auto; max-height: 6; overflow-y: auto; padding-top: 1; color: $deck-muted; }
#sessions { height: 1fr; background: $deck-bg; scrollbar-size: 1 1; }
DataTable > .datatable--header { background: $deck-surface; color: $deck-text; text-style: bold; }
DataTable > .datatable--cursor { background: $deck-selection; color: $deck-text; }
DataTable > .datatable--odd-row { background: $deck-panel; }
#empty { height: auto; color: $deck-warning; }
#inspector { width: 35; background: $deck-panel; border-left: solid $deck-border; padding: 0 1; }
#detail-scroll { height: 1fr; }
#detail { height: auto; padding: 0 1 1 1; }
#inspector Button { width: 100%; margin-top: 1; }
#action-note { height: auto; margin: 1 0; }
.muted { color: $deck-muted; }
#statusline { height: 1; background: $deck-surface; color: $deck-muted; padding: 0 1; }
Button { border: none; }
Button.-primary { background: $deck-accent; color: $deck-on-accent; }
Button.-error { background: $deck-surface; color: $deck-error; }
ModalScreen { align: center middle; background: #000000 65%; }
#dialog { width: 76; max-width: 95%; height: auto; max-height: 95%; padding: 1 2; border: solid $deck-border; background: $deck-surface; }
.dialog-title { text-style: bold; color: $deck-accent; height: 2; }
#dialog Label { margin-top: 1; }
#dialog Input { margin: 1 0; }
.dialog-actions { height: 3; align-horizontal: right; margin-top: 1; }
.dialog-actions Button { margin-left: 1; }
#affected { height: auto; max-height: 10; border-left: solid $deck-error; padding: 0 1; margin-top: 1; }
#affected Static { margin-bottom: 1; }
.compact #sidebar { width: 23; min-width: 20; }
.compact #inspector { width: 30; }
.narrow #workspace { layout: vertical; }
.narrow #sidebar { display: none; }
.narrow #center { width: 100%; height: 1fr; min-height: 12; }
.narrow #inspector { width: 100%; height: 15; border-left: none; border-top: solid $deck-border; layout: horizontal; }
.narrow #inspector .section-title { display: none; }
.narrow #detail-scroll { width: 1fr; height: 100%; }
.narrow #inspector Button { width: 12; min-width: 10; margin: 1 0; }
.narrow #action-note { display: none; }
#help-content { height: auto; max-height: 26; padding: 1; }
#help-close { width: 100%; margin-top: 1; }

Input { background: $deck-surface; color: $deck-text; border: tall $deck-surface; }
Input:focus { border: tall $deck-accent; }
Input > .input--placeholder { color: $deck-muted; }
SelectCurrent { background: $deck-surface; border: tall $deck-surface; color: $deck-text; }
Select:focus SelectCurrent { border: tall $deck-accent; }
SelectOverlay { background: $deck-surface; color: $deck-text; border: solid $deck-border; }
Button { background: $deck-surface; color: $deck-text; }
Button:hover { background: $deck-selection; }
Button:focus { text-style: bold; outline: solid $deck-accent; }
Button:disabled { color: $deck-muted; opacity: 50%; }
Checkbox { background: $deck-panel; }
Tree > .tree--cursor { background: $deck-selection; color: $deck-text; }
#appearance { width: 16; min-width: 12; margin-left: 1; }
#palette-preview { padding: 1; height: 4; background: $deck-bg; }
#settings-dialog { width: 66; max-width: 95%; height: auto; padding: 1 2; background: $deck-panel; border: solid $deck-border; }
#settings-dialog Select { width: 100%; margin: 1 0; }

/* Quiet, framed panels inspired by terminal file managers. */
Screen { padding: 0 1; }
#topbar { height: 3; align-vertical: middle; }
#summary { width: 1fr; height: 3; background: $deck-bg; color: $deck-accent; padding: 1 1; }
#auto-refresh { width: 16; height: 3; border: none; background: $deck-bg; }
#workspace { margin-bottom: 1; }
#sidebar { width: 28; background: $deck-bg; border: round $deck-border; padding: 0 1; }
#center { border: round $deck-border; margin: 0 1; padding: 0 1; }
#inspector { width: 34; background: $deck-bg; border: round $deck-border; padding: 0 1; }
#sidebar:focus-within, #center:focus-within, #inspector:focus-within { border: round $deck-accent; }
.section-title { height: 2; padding: 0 1; color: $deck-accent; }
#toolbar { margin-top: 0; }
#filters { margin-top: 0; }
#scope { padding: 0; margin: 1 0; max-height: 3; }
#folders { background: $deck-bg; }
#legend { height: 2; padding-top: 0; text-align: center; }
#action-note { margin: 1 0 0 0; }
#statusline { background: $deck-bg; }
Footer { background: $deck-bg; }
#sessions { scrollbar-size: 1 1; overflow-x: scroll; overflow-y: scroll; }
#folders, #detail-scroll, #sessions, #scope {
    scrollbar-color: $deck-muted;
    scrollbar-color-hover: $deck-accent;
    scrollbar-color-active: $deck-accent;
    scrollbar-background: $deck-surface;
    scrollbar-background-hover: $deck-surface;
    scrollbar-background-active: $deck-surface;
    scrollbar-corner-color: $deck-bg;
}
.narrow #center { margin: 0 0 1 0; }
.narrow #inspector { border: round $deck-border; }
